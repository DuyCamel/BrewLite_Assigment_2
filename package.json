{
  "name": "brewlite",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB,TUNNEL \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"cloudflared tunnel --url http://localhost:4000\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:check": "npm run db:check -w apps/api",
    "format": "prettier --write apps/web/src apps/api/src apps/api/scripts apps/api/test docs README.md"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.30.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.3"
  }
}
